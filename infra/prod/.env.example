# EPIC-XF-10-S03 (HRMS-040) — the production secret and configuration contract.
#
# Copy to `.env` NEXT TO THIS FILE on the production host and fill in real
# values. `.env` is gitignored and must never be committed; this example is the
# only version of it that is in version control, and it contains no secret.
#
# Every value below reaches the containers through the environment
# (docker-compose.yml), never through an image layer. Nothing here is baked
# into a build — see backoffice/Dockerfile for why the console image has no
# environment-specific value in it at all.
#
# Generate each secret on the host, not on a laptop, and not in a chat window:
#
#     openssl rand -hex 32
#
# ---------------------------------------------------------------------------
# Where this deployment lives
# ---------------------------------------------------------------------------
# The single public hostname. Both the console and the API are served from it;
# the API is reached under /api. DNS must already point at this VPS before the
# first `docker compose up`, or Let's Encrypt's TLS challenge fails.
HERMES_DOMAIN=hermes.example.com

# Let's Encrypt sends expiry warnings here. A real, monitored mailbox — not a
# personal address that stops being read when someone changes role.
ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------------------
# Which build is deployed (HRMS-041)
# ---------------------------------------------------------------------------
# Set by the release pipeline. Deploying is changing IMAGE_TAG and re-running
# deploy.sh; ROLLING BACK IS THE SAME ACTION WITH THE PREVIOUS TAG, which is
# the whole reason these are immutable, content-addressable tags and never
# `latest`.
API_IMAGE=ghcr.io/OWNER/hermes-api
CONSOLE_IMAGE=ghcr.io/OWNER/hermes-console
IMAGE_TAG=v0.1.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MariaDB is not published to the host, so `mariadb` is a compose-network name.
# DATABASE_URL must agree with MARIADB_USER / MARIADB_PASSWORD / MARIADB_DATABASE
# below — they are separate variables because the server and the client are
# separate containers, and they are the single most common thing to get wrong.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=hermes
MARIADB_USER=hermes
MARIADB_PASSWORD=
DATABASE_URL=mysql://hermes:CHANGE-ME@mariadb:3306/hermes

# ---------------------------------------------------------------------------
# Tokens (HRMS-021). Boot refuses anything under 32 bytes, and refuses two
# identical secrets — with one shared key a refresh token verifies as an access
# token. Two DIFFERENT values, both from `openssl rand -hex 32`.
# ---------------------------------------------------------------------------
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_HOURS=3
REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# The platform administrator (HRMS-024), re-pointed at every boot.
#
# D-17 (resolved 2026-09-18): there is no rotation mechanism and none will be
# built. Rotating this credential therefore means editing this file and
# restarting the API — which is exactly why it lives here and not in an image.
# ---------------------------------------------------------------------------
SYSADMIN_EMAIL=admin@example.com
SYSADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Invitation email (EPIC-IA-07). Unlike everything above these are NOT
# fail-fast: without them `POST /user` still creates the account and issues a
# valid invite token, it just cannot send it, and says so loudly in the logs.
# Leaving them blank is a decision to hand invite links over by other means.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hermes <no-reply@example.com>"

# ---------------------------------------------------------------------------
# PinME GPS ingestion (EPIC-FT-01, D-15). HTTP Basic, pull-only. Leave blank
# until fleet telemetry is switched on for this environment.
# ---------------------------------------------------------------------------
TRACKING_API_BASE_URL=https://api.pinme.io/api
TRACKING_API_USER=
TRACKING_API_PASSWORD=

# ---------------------------------------------------------------------------
# Logging (HRMS-044). See docs/OPERATIONS.md for the destination and the
# monitored conditions. `info` in production; `debug` leaks request detail.
# ---------------------------------------------------------------------------
RUST_LOG=info
