# Hermes em rede interna ou VPN (docker-compose.internal.yml). Copie para `.env` NESTA pasta e preencha.
# `.env` nunca vai para o git; este exemplo não tem segredo.
#
# Gere cada segredo no servidor: openssl rand -hex 32

# Endereço pelo qual os usuários abrem o console, SEM barra no final. Ele entra na lista de origens do
# backend (CORS) e nos links de convite por e-mail. Ex.: http://192.168.0.10:8080 ou http://hermes.interno:8080
HERMES_URL=http://localhost:8080
# Porta publicada no servidor.
CONSOLE_PORT=8080

# Marca das imagens construídas localmente (use uma tag fixa por atualização, para poder voltar atrás).
IMAGE_TAG=local

# --- Banco (MariaDB, compatível com MySQL). DATABASE_URL precisa concordar com usuário/senha/banco abaixo.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=hermes
MARIADB_USER=hermes
MARIADB_PASSWORD=
DATABASE_URL=mysql://hermes:TROQUE-PELA-SENHA-DO-BANCO@mariadb:3306/hermes

# --- Tokens. Dois valores DIFERENTES, cada um com pelo menos 32 bytes.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_HOURS=3
REFRESH_TOKEN_DAYS=7

# --- Administrador da plataforma (recriado a cada subida; para trocar a senha, edite aqui e reinicie a API).
SYSADMIN_EMAIL=admin@example.com
SYSADMIN_PASSWORD=

# --- E-mail de convite (opcional). Em branco: o usuário é criado mas o link de convite não é enviado
# (o servidor avisa no log) e você entrega o link por outro meio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hermes <no-reply@example.com>"

# --- PinME (rastreamento da Transmega). Autenticação HTTP Basic, somente leitura.
# Com as três preenchidas, a presença dos veículos na garagem passa a ser lida do provedor.
TRACKING_API_BASE_URL=https://api.pinme.io/api
TRACKING_API_EMAIL=
TRACKING_API_PASSWORD=
# Intervalo da leitura de presença, em segundos (60 por padrão; 0 desliga).
GARAGE_PRESENCE_POLL_INTERVAL_SECONDS=60
# Avaliação da manutenção planejada não executada (C-026), em segundos (300 por padrão; 0 desliga).
NON_EXECUTION_EVALUATION_INTERVAL_SECONDS=300

# --- Combustível (CTA Smart). Token vazio = sincronização indisponível (503).
FUEL_API_BASE_URL=https://www.ctasmart.com.br:8443
FUEL_API_TOKEN=

RUST_LOG=info
