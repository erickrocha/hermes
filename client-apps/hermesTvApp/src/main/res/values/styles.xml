<resources>
    <style name="Theme.Hermes.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:editTextColor">?attr/hermesTextPrimary</item>
        <item name="android:textColorHint">?attr/hermesTextSecondary</item>
    </style>

    <style name="Theme.Hermes.Transmega" parent="Theme.Hermes.Base">
        <item name="android:colorAccent">@color/transmega_accent</item>
        <item name="android:windowBackground">@color/transmega_screen_background</item>
        <item name="hermesScreenBackground">@color/transmega_screen_background</item>
        <item name="hermesTextPrimary">@color/transmega_text_primary</item>
        <item name="hermesTextSecondary">@color/transmega_text_secondary</item>
        <item name="hermesError">@color/transmega_error</item>
        <item name="hermesMonitorBackground">@color/transmega_monitor_background</item>
        <item name="hermesMonitorSurface">@color/transmega_monitor_surface</item>
        <item name="hermesMonitorSurfaceRaised">@color/transmega_monitor_surface_raised</item>
        <item name="hermesMonitorText">@color/transmega_monitor_text</item>
        <item name="hermesMonitorTextMuted">@color/transmega_monitor_text_muted</item>
        <item name="hermesMonitorAccent">@color/transmega_monitor_accent</item>
        <item name="hermesMonitorOk">@color/transmega_monitor_ok</item>
        <item name="hermesMonitorWarning">@color/transmega_monitor_warning</item>
        <item name="hermesMonitorDanger">@color/transmega_monitor_danger</item>
        <item name="hermesMonitorOutline">@color/transmega_monitor_outline</item>
    </style>

    <style name="Theme.Hermes.Default" parent="Theme.Hermes.Base">
        <item name="android:colorAccent">@color/hermes_accent</item>
        <item name="android:windowBackground">@color/hermes_screen_background</item>
        <item name="hermesScreenBackground">@color/hermes_screen_background</item>
        <item name="hermesTextPrimary">@color/hermes_text_primary</item>
        <item name="hermesTextSecondary">@color/hermes_text_secondary</item>
        <item name="hermesError">@color/hermes_error</item>
        <item name="hermesMonitorBackground">@color/hermes_monitor_background</item>
        <item name="hermesMonitorSurface">@color/hermes_monitor_surface</item>
        <item name="hermesMonitorSurfaceRaised">@color/hermes_monitor_surface_raised</item>
        <item name="hermesMonitorText">@color/hermes_monitor_text</item>
        <item name="hermesMonitorTextMuted">@color/hermes_monitor_text_muted</item>
        <item name="hermesMonitorAccent">@color/hermes_monitor_accent</item>
        <item name="hermesMonitorOk">@color/hermes_monitor_ok</item>
        <item name="hermesMonitorWarning">@color/hermes_monitor_warning</item>
        <item name="hermesMonitorDanger">@color/hermes_monitor_danger</item>
        <item name="hermesMonitorOutline">@color/hermes_monitor_outline</item>
    </style>

    <!-- The manifest theme, before the stored choice is applied. -->
    <style name="AppTheme" parent="Theme.Hermes.Transmega" />

    <style name="TextAppearance.Hermes.Title" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">?attr/hermesTextPrimary</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="TextAppearance.Hermes.Body" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">?attr/hermesTextSecondary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Hermes.Error" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">?attr/hermesError</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>