<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="TextAppearance.Hermes.Title" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="TextAppearance.Hermes.Body" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Hermes.Error" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>