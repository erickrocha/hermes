# Copy to .env and fill in real values. Every one of these is required --
# web::start fails fast (EPIC-XF-04-S01) if any is absent.

# Matches infra/dev/docker-compose.yml's MariaDB service.
DATABASE_URL=mysql://hermes:brutal@localhost:3307/hermes
HOST=127.0.0.1
PORT=8080

# Any long random string; distinct secrets per environment.
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# The platform's one administrator, provisioned/re-pointed at every boot
# (UserUseCase::seed_sysadmin). No default -- see EPIC-XF-04-S01.
SYSADMIN_EMAIL=admin@hermes.com
SYSADMIN_PASSWORD=change-me-admin-password

# EPIC-IA-07 (D-07): account-invitation email. Unlike everything above,
# these are NOT fail-fast at boot -- see business::commons::email_sender for
# why. Without them, POST /user still creates the account and issues a valid
# invite token; it just can't email it, and says so loudly in the logs.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM=Hermes <no-reply@hermes.example.com>

# The backoffice's own base URL, used to build the /accept-invite?token=...
# link this invite email points to. Defaults to the Vite dev server if unset.
BACKOFFICE_BASE_URL=http://localhost:5173
